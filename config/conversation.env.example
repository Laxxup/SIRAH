# Copy this file to ~/.config/sirah/conversation.env, then replace the values.
# Keep the actual file private: chmod 600 ~/.config/sirah/conversation.env

# Ollama or an OpenAI-compatible Ollama Cloud endpoint.
SIRAH_OLLAMA_HOST=http://127.0.0.1:11434
SIRAH_OLLAMA_MODEL=gpt-oss:20b-cloud
# SIRAH_OLLAMA_API_KEY=
# default preserves endpoint behavior; low reduces gpt-oss reasoning budget.
SIRAH_OLLAMA_THINK=default

# Groq Whisper cloud speech recognition.
SIRAH_STT_PROVIDER=groq
SIRAH_GROQ_API_KEY=

# Edge uses Microsoft neural voices without an Azure Speech key.
SIRAH_TTS_PROVIDER=edge
SIRAH_EDGE_TTS_VOICE=es-MX-DaliaNeural
