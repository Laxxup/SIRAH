# Server-only settings. Replace every example secret before use.
SIRAH_RUNTIME_SOCKET=/run/sirah/runtime.sock
SIRAH_RUNTIME_CLI_SECRET=replace-with-cli-shared-secret
SIRAH_RUNTIME_WEB_LAB_SECRET=replace-with-cli-shared-secret
SIRAH_RUNTIME_PROFILE=dev_laptop
SIRAH_RUNTIME_CAPTURE_DEVICES=default
SIRAH_RUNTIME_CAPTURE_DEVICE=default
SIRAH_RUNTIME_OUTPUT_DEVICES=default
SIRAH_RUNTIME_OUTPUT_DEVICE=default

# ── LLM ──────────────────────────────────────────────────────
SIRAH_LLM_PROVIDER=ollama
SIRAH_OLLAMA_URL=http://127.0.0.1:11434
SIRAH_OLLAMA_MODEL=gpt-oss:120b-cloud
SIRAH_OLLAMA_FALLBACK_MODEL=gemma3:4b
SIRAH_OLLAMA_TIMEOUT=30.0

# ── TTS ──────────────────────────────────────────────────────
SIRAH_TTS_PROVIDER=kokoro_http
SIRAH_KOKORO_URL=http://127.0.0.1:8880/v1
SIRAH_KOKORO_MODEL=kokoro
SIRAH_KOKORO_VOICE=ef_dora
SIRAH_KOKORO_SPEED=1.0
SIRAH_KOKORO_TIMEOUT=30.0

# ── Personality ──────────────────────────────────────────────
SIRAH_PERSONALITY_DIR=config/personality
