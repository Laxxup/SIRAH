# Punto de partida: cp .env.example .env y completa tus claves.
# Nunca versiones .env con secretos. Los valores son ejemplos recomendados;
# los defaults reales se indican expresamente donde corresponda.

# Required service credentials.
LLM_API_KEY=
GROQ_API_KEY=

# OpenAI-compatible LLM endpoint and model (OpenCode Go + Kimi K2.6).
# Go usa el namespace zen/go/v1 (con tu suscripción, sin saldo Zen).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.6
LLM_TIMEOUT=90s
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=none
# Optional speech creativity in [0,2]; unset = 0 (deterministic JSON).
LLM_TEMPERATURE=

# Speech-to-text (Groq).
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=es
STT_TIMEOUT=30s

# Normal runtime STT path.
STT_PREPROCESSOR=raw
# Set STT_PREPROCESSOR=rnnoise only for an experimental build:
# go run -tags rnnoise ./cmd/sirah -voice

# Audio capture (defaults del runtime).
ARECORD_COMMAND=arecord
AUDIO_INPUT_DEVICE=plughw:CARD=PCH,DEV=0
VOICE_COOLDOWN_MS=200

# Local Piper voice model and process settings.
# La voz .onnx no se versiona: colócala en models/voices/ (ver docs/piper.md)
# y apunta PIPER_MODEL a tu archivo.
PIPER_MODEL=models/voices/es_MX-claude-high.onnx
PIPER_COMMAND=.venv-piper/bin/python
PIPER_SCRIPT=scripts/piper_server.py
PIPER_AUDIO_COMMAND=aplay
PIPER_AUDIO_DEVICE=
PIPER_PREBUFFER_MS=80ms

# Demo corporal: vacio desactiva el saludo; blink natural se puede apagar.
WAKEUP_TEXT=Hola, hola... me acabo de despertar.
# Genera un saludo distinto con el LLM; WAKEUP_TEXT queda como fallback.
CREATIVE_WAKEUP_ENABLED=false
NATURAL_BLINK_ENABLED=true

# Vision (Linux + OpenCV 5, o OpenCV 4 con -tags opencv4).
VISION_ENABLED=true
VISION_MODEL=models/face_detection_yunet_2023mar.onnx
VISION_CAMERA_INDEX=0

# Serial del ESP32. Vacío = hardware no disponible (modo degradado, la
# conversación sigue funcionando sin ojos físicos).
FIRMWARE_SERIAL=
FIRMWARE_BAUD=115200

# Sesión y memoria conversacional.
AGENT_SESSION_ID=default
AGENT_USER_ID=local-user
AGENT_HISTORY_LIMIT=12

# Optional persistent memory service (vacío = solo memoria local).
ZEP_API_KEY=
