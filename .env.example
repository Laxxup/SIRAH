# Punto de partida: cp .env.example .env y completa lo necesario.
# Nunca versiones .env con secretos.
#
# Estructura:
#   1. Basic conversation   — lo mínimo para hablar con SIRAH por texto
#   2. Voice                — micrófono, STT y salida hablada (Piper)
#   3. Vision               — cámara y seguimiento facial (opt-in)
#   4. Memory               — memoria conversacional persistente (opt-in)
#   5. Hardware             — ESP32 y ojos físicos (opt-in)
#   6. Advanced             — afinación de VAD y opciones experimentales

# =============================================================================
# 1. BASIC CONVERSATION
# =============================================================================
# Obligatorio: clave del proveedor LLM OpenAI-compatible.
LLM_API_KEY=

# Endpoint y modelo. Los ejemplos apuntan a OpenCode Go + Kimi K2.6;
# cambia a tu proveedor preferido (Groq, OpenAI, etc.).
# Default interno si están vacíos: https://api.groq.com/openai/v1 y openai/gpt-oss-20b.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.6
LLM_TIMEOUT=90s
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=none

# Optional speech creativity in [0,2]; unset = 0 (deterministic JSON).
LLM_TEMPERATURE=

# Sesión y memoria conversacional local.
AGENT_SESSION_ID=default
AGENT_USER_ID=local-user
AGENT_HISTORY_LIMIT=12

# Personalidad activa. Vacío = busca personas/active.persona.json o default.
SIRAH_PERSONA=

# =============================================================================
# 2. VOICE (microphone + speech output)
# =============================================================================
# GROQ_API_KEY es necesario SOLO para el modo manos libres (-voice).
# No se usa en conversación por texto.
GROQ_API_KEY=

# Modelo e idioma de transcripción STT.
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=es
STT_TIMEOUT=30s

# Preprocesador de audio: "raw" (default) o "rnnoise" (experimental, requiere
# compilar con -tags rnnoise y librerías nativas).
STT_PREPROCESSOR=raw

# Comando y dispositivo de captura ALSA.
# Si están vacíos, el runtime usa "arecord" y el default del sistema.
ARECORD_COMMAND=
AUDIO_INPUT_DEVICE=

# Pausa entre turnos en modo voz.
VOICE_COOLDOWN_MS=200ms

# Piper TTS: comando de Python, script bridge, modelo de voz y reproductor.
# El modelo .onnx y su .onnx.json deben existir; no se versionan en Git.
# Ver docs/piper.md para setup.
PIPER_MODEL=models/voices/es_MX-claude-high.onnx
PIPER_COMMAND=.venv-piper/bin/python
PIPER_SCRIPT=scripts/piper_server.py
PIPER_AUDIO_COMMAND=aplay
PIPER_AUDIO_DEVICE=
PIPER_PREBUFFER_MS=80ms

# Saludo inicial en modo voz. Vacío = desactivado.
WAKEUP_TEXT=Hola, hola... me acabo de despertar.

# Genera saludo distinto mediante LLM; WAKEUP_TEXT queda como fallback.
CREATIVE_WAKEUP_ENABLED=false

# Parpadeo natural cuando hay hardware conectado.
NATURAL_BLINK_ENABLED=true

# =============================================================================
# 3. VISION (opt-in)
# =============================================================================
# Vision está desactivada por defecto. Actívala con VISION_ENABLED=true
# o mediante el flag -preview (requiere OpenCV y cámara V4L2).
VISION_ENABLED=false
VISION_MODEL=models/face_detection_yunet_2023mar.onnx
VISION_CAMERA_INDEX=0

# =============================================================================
# 4. MEMORY (opt-in)
# =============================================================================
# Zep proporciona memoria persistente entre sesiones. Vacío = solo memoria local.
ZEP_API_KEY=

# =============================================================================
# 5. HARDWARE (opt-in)
# =============================================================================
# Puerto serial del ESP32. Vacío = modo degradado sin ojos físicos.
FIRMWARE_SERIAL=
FIRMWARE_BAUD=115200

# =============================================================================
# 6. ADVANCED — VAD tuning
# =============================================================================
# Estos valores ajustan el Voice Activity Detector en modo voz.
# No necesitas cambiarlos para empezar.
VOICE_START_FRAMES=3
VOICE_SILENCE_MS=400ms
VOICE_MAX_TURN_MS=10s
VOICE_PREBUFFER_MS=300ms
VOICE_MIN_SPEECH_MS=100ms
VOICE_NOISE_CALIBRATION_MS=500ms
VOICE_START_MULTIPLE=1.6
VOICE_END_MULTIPLE=1.2
VOICE_MIN_START_RMS=1200
VOICE_MIN_END_RMS=600
