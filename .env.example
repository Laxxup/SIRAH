# SIRAH Runtime Configuration
# Copia este archivo a .env y ajusta:
#   cp .env.example .env

# ── LLM Provider ─────────────────────────────────────────────
# ollama | groq | fake
SIRAH_LLM_PROVIDER=ollama

# Ollama (local server that can route to Ollama Cloud)
SIRAH_OLLAMA_URL=http://127.0.0.1:11434
SIRAH_OLLAMA_MODEL=gpt-oss:120b-cloud
SIRAH_OLLAMA_FALLBACK_MODEL=gemma3:4b
SIRAH_OLLAMA_TIMEOUT=30.0

# Groq (alternative provider, not used as fallback)
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ── TTS Provider ─────────────────────────────────────────────
# kokoro_http | piper | fake
SIRAH_TTS_PROVIDER=kokoro_http

# Kokoro HTTP server
SIRAH_KOKORO_URL=http://127.0.0.1:8880/v1
SIRAH_KOKORO_MODEL=kokoro
SIRAH_KOKORO_VOICE=ef_dora
SIRAH_KOKORO_SPEED=1.0
SIRAH_KOKORO_TIMEOUT=30.0

# ── Personality ──────────────────────────────────────────────
SIRAH_PERSONALITY_DIR=config/personality
